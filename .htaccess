# ═══════════════════════════════════════════════════════════
# Polska bliżej — konfiguracja Apache
# ═══════════════════════════════════════════════════════════

# ───── 1. Przekierowanie na HTTPS ─────
<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]
</IfModule>

# ───── 2. Przekierowanie www → bez www (lub odwrotnie) ─────
# Wybierz JEDNĄ wersję — odkomentuj tę, którą chcesz:

# Wersja bez www:
<IfModule mod_rewrite.c>
  RewriteCond %{HTTP_HOST} ^www\.polandsecrets\.com$ [NC]
  RewriteRule ^(.*)$ https://polandsecrets.com/$1 [R=301,L]
</IfModule>

# Wersja z www (jeśli wolisz):
# RewriteCond %{HTTP_HOST} ^polandsecrets\.com$ [NC]
# RewriteRule ^(.*)$ https://www.polandsecrets.com/$1 [R=301,L]

# ───── 3. Usuń końcowy ukośnik (opcjonalnie) ─────
# /blog/ → /blog  (żeby uniknąć duplikatów)
# Uwaga: może psuć linki do folderów, jeśli nie masz index.html
# RewriteCond %{REQUEST_FILENAME} !-d
# RewriteRule ^(.+)/$ /$1 [R=301,L]

# ───── 4. Cache dla statycznych plików ─────
<IfModule mod_expires.c>
  ExpiresActive On

  # Obrazki — 1 rok
  ExpiresByType image/webp "access plus 1 year"
  ExpiresByType image/svg+xml "access plus 1 year"
  ExpiresByType image/png "access plus 1 year"
  ExpiresByType image/jpeg "access plus 1 year"
  ExpiresByType image/x-icon "access plus 1 year"

  # CSS/JS — 1 miesiąc
  ExpiresByType text/css "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"

  # HTML — 1 dzień (bo często się zmienia)
  ExpiresByType text/html "access plus 1 day"

  # Fonty — 1 rok
  ExpiresByType font/woff2 "access plus 1 year"
  ExpiresByType font/woff "access plus 1 year"
</IfModule>

# Favicon — nie cache'uj agresywnie (żeby zmiany były widoczne)
<FilesMatch "favicon\.(svg|ico|png)$">
  <IfModule mod_headers.c>
    Header set Cache-Control "no-cache, must-revalidate"
  </IfModule>
</FilesMatch>

# ───── 5. Kompresja Gzip ─────
<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html
  AddOutputFilterByType DEFLATE text/css
  AddOutputFilterByType DEFLATE text/javascript
  AddOutputFilterByType DEFLATE application/javascript
  AddOutputFilterByType DEFLATE application/json
  AddOutputFilterByType DEFLATE image/svg+xml
  AddOutputFilterByType DEFLATE application/xml
  AddOutputFilterByType DEFLATE text/plain
</IfModule>

# ───── 6. Nagłówki bezpieczeństwa ─────
<IfModule mod_headers.c>
  # Zapobiega osadzaniu strony w iframe (clickjacking)
  Header set X-Frame-Options "SAMEORIGIN"

  # Zapobiega sniffowaniu typu MIME
  Header set X-Content-Type-Options "nosniff"

  # Referrer policy
  Header set Referrer-Policy "strict-origin-when-cross-origin"

  # Permissions policy
  Header set Permissions-Policy "geolocation=(), microphone=(), camera=()"
</IfModule>

# ───── 7. Blokada dostępu do plików źródłowych ─────
<FilesMatch "\.(json|js|md|txt|log|bak|sh|env)$">
  # Zablokuj dostęp do wybranych plików (opcjonalnie)
  # Uwaga: jeśli blokujesz .js, search.js przestanie działać!
  # Zostaw to zakomentowane, chyba że wiesz, co robisz:
  # Require all denied
</FilesMatch>

# ═══════════════════════════════════════════════════════════
# 9. Stare adresy → strony kierunków (301)
# ═══════════════════════════════════════════════════════════
# Do tej pory sitemap zgłaszał /article.html?id=… jako ~124 osobne strony,
# ale wszystkie serwowały identyczny HTML z canonicalem /article.html.
# Kierujemy je 301 na właściwe, unikalne strony /kierunki/*.html.
<IfModule mod_rewrite.c>
  RewriteEngine On

  # /article.html?id=baltyk → /kierunki/baltyk.html
  RewriteCond %{QUERY_STRING} ^id=([a-z0-9-]+)(&.*)?$ [NC]
  RewriteRule ^article\.html$ /kierunki/%1.html? [R=301,L]

  # Duplikaty slugów (resolve-duplicates.js)
  RewriteRule ^kierunki/sopot-plaza\.html$ /kierunki/sopot.html [R=301,L]
  RewriteRule ^kierunki/sopot-plaza-en\.html$ /kierunki/sopot-en.html [R=301,L]
  RewriteRule ^kierunki/pn-karkonoski\.html$ /kierunki/karkonosze.html [R=301,L]
  RewriteRule ^kierunki/pn-karkonoski-en\.html$ /kierunki/karkonosze-en.html [R=301,L]
  RewriteRule ^kierunki/pn-bieszczadzki\.html$ /kierunki/bieszczady.html [R=301,L]
  RewriteRule ^kierunki/pn-bieszczadzki-en\.html$ /kierunki/bieszczady-en.html [R=301,L]
  RewriteRule ^kierunki/pn-pieninski\.html$ /kierunki/pieniny.html [R=301,L]
  RewriteRule ^kierunki/pn-pieninski-en\.html$ /kierunki/pieniny-en.html [R=301,L]
  RewriteRule ^kierunki/pn-gor-stolowych\.html$ /kierunki/stolowe.html [R=301,L]
  RewriteRule ^kierunki/pn-gor-stolowych-en\.html$ /kierunki/stolowe-en.html [R=301,L]
  RewriteRule ^kierunki/pn-roztoczanski\.html$ /kierunki/roztocze.html [R=301,L]
  RewriteRule ^kierunki/pn-roztoczanski-en\.html$ /kierunki/roztocze-en.html [R=301,L]
  RewriteRule ^kierunki/pn-swietokrzyski\.html$ /kierunki/swietokrzyskie.html [R=301,L]
  RewriteRule ^kierunki/pn-swietokrzyski-en\.html$ /kierunki/swietokrzyskie-en.html [R=301,L]
  RewriteRule ^kierunki/tatrzanski-park\.html$ /kierunki/tatry.html [R=301,L]
  RewriteRule ^kierunki/tatrzanski-park-en\.html$ /kierunki/tatry-en.html [R=301,L]
  RewriteRule ^kierunki/bialowieza\.html$ /kierunki/pn-bialowieski.html [R=301,L]
  RewriteRule ^kierunki/bialowieza-en\.html$ /kierunki/pn-bialowieski-en.html [R=301,L]
  RewriteRule ^kierunki/biebrza\.html$ /kierunki/pn-biebrzanski.html [R=301,L]
  RewriteRule ^kierunki/biebrza-en\.html$ /kierunki/pn-biebrzanski-en.html [R=301,L]
  RewriteRule ^kierunki/babia\.html$ /kierunki/pn-babiogorski.html [R=301,L]
  RewriteRule ^kierunki/babia-en\.html$ /kierunki/pn-babiogorski-en.html [R=301,L]
  RewriteRule ^kierunki/ojcow\.html$ /kierunki/pn-ojcowski.html [R=301,L]
  RewriteRule ^kierunki/ojcow-en\.html$ /kierunki/pn-ojcowski-en.html [R=301,L]
  RewriteRule ^kierunki/kampinos\.html$ /kierunki/pn-kampinoski.html [R=301,L]
  RewriteRule ^kierunki/kampinos-en\.html$ /kierunki/pn-kampinoski-en.html [R=301,L]
  RewriteRule ^kierunki/narew\.html$ /kierunki/pn-narwianski.html [R=301,L]
  RewriteRule ^kierunki/narew-en\.html$ /kierunki/pn-narwianski-en.html [R=301,L]
  RewriteRule ^kierunki/polesie\.html$ /kierunki/pn-poleski.html [R=301,L]
  RewriteRule ^kierunki/polesie-en\.html$ /kierunki/pn-poleski-en.html [R=301,L]
  RewriteRule ^kierunki/wigierski-park\.html$ /kierunki/pn-wigierski.html [R=301,L]
  RewriteRule ^kierunki/wigierski-park-en\.html$ /kierunki/pn-wigierski-en.html [R=301,L]
  RewriteRule ^kierunki/drawa\.html$ /kierunki/pn-drawienski.html [R=301,L]
  RewriteRule ^kierunki/drawa-en\.html$ /kierunki/pn-drawienski-en.html [R=301,L]
  RewriteRule ^kierunki/drawsko\.html$ /kierunki/pn-drawienski.html [R=301,L]
  RewriteRule ^kierunki/drawsko-en\.html$ /kierunki/pn-drawienski-en.html [R=301,L]
  RewriteRule ^kierunki/bory-tucholskie\.html$ /kierunki/pn-bory-tucholskie.html [R=301,L]
  RewriteRule ^kierunki/bory-tucholskie-en\.html$ /kierunki/pn-bory-tucholskie-en.html [R=301,L]
  RewriteRule ^kierunki/slowinski-park\.html$ /kierunki/pn-slowinski.html [R=301,L]
  RewriteRule ^kierunki/slowinski-park-en\.html$ /kierunki/pn-slowinski-en.html [R=301,L]
  RewriteRule ^kierunki/pn-gorczanski\.html$ /kierunki/gorce.html [R=301,L]
  RewriteRule ^kierunki/pn-gorczanski-en\.html$ /kierunki/gorce-en.html [R=301,L]
</IfModule>

# ───── 8. Własna strona 404 (opcjonalnie) ─────
ErrorDocument 404 /404.html