# ═══════════════════════════════════════════════════════════
# Duplikaty — przekierowania 301
# Wygenerowane przez resolve-duplicates.js
# Wklej do głównego .htaccess poniżej istniejącego RewriteEngine On
# ═══════════════════════════════════════════════════════════

# sopot-plaza → sopot
RewriteRule ^kierunki/sopot-plaza\.html$ /kierunki/sopot.html [R=301,L]
RewriteRule ^kierunki/sopot-plaza-en\.html$ /kierunki/sopot-en.html [R=301,L]

