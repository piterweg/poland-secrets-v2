# ==============================================================================
#  .htaccess dla polandsecrets.com – Hostinger (LiteSpeed)
#  Sekcje: 1. Przekierowania  2. Wydajność  3. Bezpieczeństwo  4. Dodatki
# ==============================================================================

# ──────────────────────────────────────────────────────────────────────────────
#  1. PRZEKIEROWANIA (301 – SEO)
# ──────────────────────────────────────────────────────────────────────────────
<IfModule mod_rewrite.c>
  RewriteEngine On

  # 1a. Wymuszenie HTTPS
  RewriteCond %{HTTPS} off
  RewriteRule ^(.*)$ https://%{HTTP_HOST}/$1 [R=301,L]

  # 1b. Wymuszenie wersji bez „www”
  RewriteCond %{HTTP_HOST} ^www\.polandsecrets\.com$ [NC]
  RewriteRule ^(.*)$ https://polandsecrets.com/$1 [R=301,L]

  # 1c. Stare adresy article.html?id=…  →  /kierunki/<id>.html
  RewriteCond %{QUERY_STRING} ^id=([\w-]+)$
  RewriteRule ^article\.html$ /kierunki/%1.html? [R=301,L]

  # 1d. Fallback: article.html bez parametru → strona główna
  RewriteRule ^article\.html$ /index.html [R=301,L]

  # 1e. Usunięcie „index.html” z adresu
  RewriteCond %{THE_REQUEST} \s/+(.*/)?index\.html[\s?] [NC]
  RewriteRule ^(.*?)index\.html$ /$1 [R=301,L]
</IfModule>

# ──────────────────────────────────────────────────────────────────────────────
#  2. WYDAJNOŚĆ
# ──────────────────────────────────────────────────────────────────────────────

<IfModule mod_expires.c>
  ExpiresActive On
  ExpiresByType image/webp            "access plus 1 year"
  ExpiresByType image/avif            "access plus 1 year"
  ExpiresByType image/jpeg            "access plus 1 year"
  ExpiresByType image/png             "access plus 1 year"
  ExpiresByType image/gif             "access plus 1 year"
  ExpiresByType image/svg+xml         "access plus 1 year"
  ExpiresByType image/x-icon          "access plus 1 year"
  ExpiresByType font/woff2            "access plus 1 year"
  ExpiresByType font/woff             "access plus 1 year"
  ExpiresByType text/css              "access plus 1 month"
  ExpiresByType application/javascript "access plus 1 month"
  ExpiresByType text/javascript       "access plus 1 month"
  ExpiresByType application/json      "access plus 1 day"
  ExpiresByType text/html             "access plus 0 seconds"
  ExpiresDefault                      "access plus 7 days"
</IfModule>

<IfModule mod_headers.c>
  <FilesMatch "\.(webp|avif|jpe?g|png|gif|svg|ico|woff2?)$">
    Header set Cache-Control "public, max-age=31536000, immutable"
  </FilesMatch>
  <FilesMatch "\.(css|js)$">
    Header set Cache-Control "public, max-age=2592000"
  </FilesMatch>
  <FilesMatch "\.json$">
    Header set Cache-Control "public, max-age=86400"
  </FilesMatch>
  <FilesMatch "\.(html?)$">
    Header set Cache-Control "no-cache, must-revalidate"
  </FilesMatch>
</IfModule>

<IfModule mod_brotli.c>
  AddOutputFilterByType BROTLI_COMPRESS text/html text/plain text/xml text/css
  AddOutputFilterByType BROTLI_COMPRESS application/javascript application/json
  AddOutputFilterByType BROTLI_COMPRESS application/xml image/svg+xml
</IfModule>

<IfModule mod_deflate.c>
  AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css
  AddOutputFilterByType DEFLATE application/javascript application/json
  AddOutputFilterByType DEFLATE application/xml image/svg+xml
</IfModule>

<IfModule mod_headers.c>
  Header set Alt-Svc 'h3=":443"; ma=86400'
</IfModule>

# ──────────────────────────────────────────────────────────────────────────────
#  3. BEZPIECZEŃSTWO
# ──────────────────────────────────────────────────────────────────────────────
<IfModule mod_headers.c>
  Header always set Strict-Transport-Security "max-age=31536000; includeSubDomains; preload"
  Header always set X-Frame-Options "SAMEORIGIN"
  Header always set X-Content-Type-Options "nosniff"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "geolocation=(), microphone=(), camera=(), payment=(), usb=(), magnetometer=(), gyroscope=(), browsing-topics=(), interest-cohort=()"

  Header always set Content-Security-Policy "default-src 'self'; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://www.googletagmanager.com https://www.google-analytics.com; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com; img-src 'self' data: https:; connect-src 'self' https://www.google-analytics.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'"

  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Cross-Origin-Resource-Policy "same-origin"
</IfModule>

# 3a. Ukrycie wersji serwera i wyłączenie listowania katalogów
ServerSignature Off
Options -Indexes

# 3b. Blokada dostępu do wrażliwych plików
#     UWAGA: NIE blokujemy .json i .md — są potrzebne na stronie (fetch z JS)
<FilesMatch "\.(env|log|ini|sql|bak|old|lock)$">
  Require all denied
</FilesMatch>

# 3c. Blokada niebezpiecznych metod HTTP
<LimitExcept GET POST HEAD>
  Require all denied
</LimitExcept>

# ──────────────────────────────────────────────────────────────────────────────
#  4. DODATKI
# ──────────────────────────────────────────────────────────────────────────────

ErrorDocument 404 /404.html

AddDefaultCharset UTF-8

# ==============================================================================
#  KONIEC PLIKU
# ==============================================================================