+// Encje HTML dekodujemy PRZED liczeniem słów i budową meta description.
+// Bez tego „&lt;” / „&#8217;” liczyły się jako osobne „słowa”,
+// a description bywał ucięty w środku encji (np. „…&nbs…”).
+const ENTITIES = {
+  '&nbsp;': ' ', '&amp;': '&', '&lt;': '<', '&gt;': '>',
+  '&quot;': '"', '&#39;': "'", '&apos;': "'", '&hellip;': '…',
+  '&mdash;': '—', '&ndash;': '–', '&oacute;': 'ó', '&aacute;': 'á',
+  '&eacute;': 'é', '&iacute;': 'í', '&ntilde;': 'ñ', '&uuml;': 'ü',
+  '&oelig;': 'œ', '&sect;': '§', '&copy;': '©', '&reg;': '®',
+};
+const stripTags = (s = '') =>
+  String(s)
+    .replace(/<\/?(strong|em|b|i|a|span|u|mark)(\s[^>]*)?>/gi, '')
+    .replace(/<[^>]+>/g, ' ')
+    // znane encje → znak; nieznane → spacja (nie psuje liczenia słów)
+    .replace(/&[a-z#0-9]+;/gi, (m) => ENTITIES[m.toLowerCase()] ?? ' ')
+    .replace(/\s+/g, ' ')
+    .trim();

